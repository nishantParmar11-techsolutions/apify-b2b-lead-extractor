# ==============================================================================
# Apify B2B Lead Extractor - Enterprise Environment Configuration Template
# ==============================================================================
# Instructions: Copy this file to '.env' and fill in your production values.
# NEVER commit your actual '.env' file to version control.
# ==============================================================================

# --- 1. API Authentication & Security ---
# Your primary Apify API token (Retrieve from Apify Console -> Account -> Integrations)
APIFY_API_TOKEN=apify_api_token_live_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional secret key for securing outgoing webhook payloads to your CRM
WEBHOOK_SECRET_KEY=super_secure_webhook_signing_secret_123

# --- 2. Target Scraping Parameters ---
# Primary niche or industry filter for prospecting
TARGET_INDUSTRY="SaaS and B2B Tech Startups"

# Geographic filter for lead localization (e.g., United States, United Kingdom)
TARGET_LOCATION="United States"

# Maximum number of items/leads to extract per execution run
MAX_ITEMS_LIMIT=500

# --- 3. Proxy & Rate-Limiting Management ---
# Enable Apify Proxy rotation to bypass bot detection and rate limits
USE_APIFY_PROXY=true
PROXY_GROUP=RESIDENTIAL

# --- 4. Export & Telemetry Storage ---
# Local directory path where structured JSON/CSV lead reports are persisted
OUTPUT_DIRECTORY="./output"
DEFAULT_EXPORT_FORMAT=json

# --- 5. Runtime, Timeout & Logging Settings ---
# Logging verbosity level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Network timeout limits and retry thresholds
REQUEST_TIMEOUT_SECONDS=30
MAX_RETRIES=3
